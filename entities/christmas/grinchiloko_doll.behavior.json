{
	"format_version": "1.21.5",
	"minecraft:entity": {
		"description": {
			"identifier": "christmas:grinchiloko_doll",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"custom:snark_calm": {
				"minecraft:on_target_acquired": {
					"event": "minecraft:become_angry",
					"target": "self"
				}
			},
			"custom:snark_angry": {
				"minecraft:angry": {
					"duration": 15,
					"broadcast_anger": true,
					"broadcast_range": 15,
					"angry_sound": "ambient.worried",
					"broadcast_targets": [
						"snark", "parasite"
					],
					"calm_event": {
						"event": "minecraft:on_calm",
						"target": "self"
					}
				},
				"minecraft:behavior.melee_attack": {
					"priority": 4,
					"track_target": true,
					"can_spread_on_fire": true,
					"cooldown_time": 0.5,
					"speed_multiplier": 1.2
				},
				"minecraft:behavior.summon_entity": {
					"summon_choices": [
						{
							"min_activation_range": 0,
							"max_activation_range": 5,
							"cooldown_time": 5,
							"weight": 3,
							"cast_duration": 2,
							"particle_color": "#4dff5359",
							"start_sound_event": "block.furnace.lit",
							"sequence": [
								{
								"shape": "circle",
								"target": "self",
								"base_delay": 1,
								"delay_per_summon": 0,
								"num_entities_spawned": 3,
								"entity_type": "christmas:grinchinion",
								"size": 1.5,
								"entity_lifespan": 40,
								"sound_event": "block.furnace.lit"
								},
								{
								"shape": "circle",
								"target": "self",
								"base_delay": 0.15,
								"delay_per_summon": 0,
								"num_entities_spawned": 5,
								"entity_type": "christmas:grinchinion",
								"size": 2.5,
								"entity_lifespan": 15
								}
							]
						}
					]
				}
			}
		},
		"components": {
			"minecraft:behavior.random_stroll": {
				"priority": 6,
				"speed_multiplier": 1
			},
			"minecraft:experience_reward": {
				"on_death": "query.last_hit_by_player ? 8 : 0"
			},
			"minecraft:type_family": {
				"family": ["snark", "parasite"]
			},
			"minecraft:breathable": {
				"total_supply": 15,
				"suffocate_time": 0
			},
			"minecraft:nameable": {
				"always_show": true,
				"allow_name_tag_renaming": true
			},
			"minecraft:loot": {
				"table": "loot_tables/nothing.json"
			},
			"minecraft:health": {
				"value": 40,
				"max": 40
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"filters": {
							"test": "in_lava",
							"subject": "self",
							"operator": "==",
							"value": true
						},
						"cause": "lava",
						"damage_per_tick": 4
					}
				]
			},
			"minecraft:movement": {
				"value": 0.3
			},
			"minecraft:behavior.delayed_attack": {
				"attack_duration": 0.5,
				"attack_once": false,
				"attack_types": "",
				"hit_delay_pct": 0.8,
				"random_stop_interval": 0,
				"reach_multiplier": 2.5,
				"require_complete_path": true,
				"track_target": true
			},
			"minecraft:attack": {
				"damage": 10
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true
			},
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
			"minecraft:collision_box": {
				"width": 0.7,
				"height": 1
			},
			"minecraft:behavior.float": {
				"priority": 1
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 2,
				"attack_interval": 1,
				"must_see": true,
				"entity_types": [
					{
						"filters": {
							"any_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "snowgolem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "irongolem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "armor_stand"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "animal"
								}
							]
						},
						"max_dist": 25
					}
				]
			},
			"minecraft:behavior.target_when_pushed": {
				"percent_chance": 10,
				"entity_types": [
					{
						"filters": {
							"test": "is_family",
							"subject": "other",
							"value": "player"
						}
					}
				]
			},
			"minecraft:behavior.look_at_player": {
				"angle_of_view_vertical": 360,
				"angle_of_view_horizontal": 360,
				"look_distance": 8,
				"probability": 0.02,
				"look_time": [
					2.0, 3.0
				],
				"target_distance": 16,
				"priority": 6
			},
			"minecraft:behavior.hurt_by_target": {
				"priority": 1,
				"alert_same_type": true
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"remove": {},
				"add": {
					"component_groups": [
						"custom:snark_calm"
					]
				}
			},
			"minecraft:become_angry": {
				"remove": {
					"component_groups": ["custom:snark_calm"]
				},
				"add": {
					"component_groups": ["custom:snark_angry"]
				}
			},
			"minecraft:on_calm": {
				"remove": {
					"component_groups": ["custom:snark_angry"]
				},
				"add": {
					"component_groups": ["custom:snark_calm"]
				}
			}
		}
	}
}