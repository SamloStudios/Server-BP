{
	"format_version": "1.16.0",
	"minecraft:entity": {
		"description": {
			"identifier": "endupdate:snark",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"custom:snark_calm": {
				"minecraft:on_target_acquired": {
					"event": "minecraft:become_angry",
					"target": "self"
				}
			},
			"custom:snark_angry": {
				"minecraft:angry": {
					"duration": 10,
					"broadcast_anger": true,
					"broadcast_range": 20,
					"angry_sound": "ambient.worried",
					"broadcast_targets": [
						"snark", "parasite"
					],
					"calm_event": {
						"event": "minecraft:on_calm",
						"target": "self"
					}
				},
				"minecraft:behavior.melee_attack": {
					"priority": 4,
					"track_target": true
				}
			}
		},
		"components": {
			
			"minecraft:experience_reward": {
				"on_death": "query.last_hit_by_player ? 5 : 0"
			},
			"minecraft:type_family": {
				"family": ["snark", "parasite"]
			},
			"minecraft:breathable": {
				"total_supply": 15,
				"suffocate_time": 0
			},
			"minecraft:nameable": {},
			"minecraft:loot": {
				"table": "loot_tables/entities/silverfish.json"
			},
			"minecraft:health": {
				"value": 20,
				"max": 20
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
					{
						"filters": {
							"test": "in_lava",
							"subject": "self",
							"operator": "==",
							"value": true
						},
						"cause": "lava",
						"damage_per_tick": 4
					}
				]
			},
			"minecraft:movement": {
				"value": 0.50
			},
			"minecraft:navigation.walk": {
				"can_path_over_water": true
			},
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
			"minecraft:attack": {
				"damage": 2
			},
			"minecraft:collision_box": {
				"width": 0.4,
				"height": 0.3
			},
			"minecraft:behavior.float": {
				"priority": 1
			},
			"minecraft:behavior.nearest_attackable_target": {
				"priority": 2,
				"attack_interval": 10,
				"entity_types": [
					{
						"filters": {
							"any_of": [
								{
									"test": "is_family",
									"subject": "other",
									"value": "player"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "snowgolem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "irongolem"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "armor_stand"
								},
								{
									"test": "is_family",
									"subject": "other",
									"value": "animal"
								}
							]
						},
						"max_dist": 8
					}
				]
			},
			"minecraft:behavior.target_when_pushed": {
				"percent_chance": 10,
				"entity_types": [
					{
						"filters": {
							"test": "is_family",
							"subject": "other",
							"value": "player"
						}
					}
				]
			},
			"minecraft:behavior.look_at_player": {
				"angle_of_view_vertical": 360,
				"angle_of_view_horizontal": 360,
				"look_distance": 8,
				"probability": 0.02,
				"look_time": [
					2.0, 3.0
				],
				"target_distance": 6,
				"priority": 6
			},
			"minecraft:behavior.hurt_by_target": {
				"priority": 1,
				"alert_same_type": true
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			}
		},
		"events": {
			"minecraft:entity_spawned": {
				"remove": {},
				"add": {
					"component_groups": [
						"custom:snark_calm"
					]
				}
			},
			"minecraft:become_angry": {
				"remove": {
					"custom:snark_calm": {}
				},
				"add": {
					"component_groups": ["custom:snark_angry"]
				}
			},
			"minecraft:on_calm": {
				"remove": {
					"custom:snark_angry": {}
				},
				"add": {
					"component_groups": ["custom:snark_calm"]
				}
			}
		}
	}
}