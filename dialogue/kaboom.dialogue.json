			{
				"scene_tag": "kaboom_aja_desvio_2",
				"npc_name": "§c!!?",
				"text": "Entonces que?\n\nUhmm...\n\nJejejej, no me acuerdo que estuvieramos hablando de otra cosa!\n\n",
